{
  "name": "repo-identity-guard",
  "displayName": "Repo ID",
  "description": "Warn when Git would commit with the wrong author identity for the current repository.",
  "version": "0.1.0",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/danishirfan21/Repo-Identity-Guard.git"
  },
  "engines": {
    "vscode": ">=1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "build:webview": "tailwindcss -i ./src/webview/sidebar.css -o ./media/sidebar.css --minify",
    "compile": "npm run build:webview && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "watch:webview": "tailwindcss -i ./src/webview/sidebar.css -o ./media/sidebar.css --watch",
    "test": "npm run compile && node --test out/test"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "repoIdentityGuard",
          "title": "Repo ID",
          "icon": "resources/repo-id.svg"
        }
      ]
    },
    "views": {
      "repoIdentityGuard": [
        {
          "id": "repoIdentityGuard.statusView",
          "name": "Status",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "repoIdentityGuard.scan",
        "title": "Repo ID: Rescan"
      },
      {
        "command": "repoIdentityGuard.showStatus",
        "title": "Repo ID: Show Status"
      },
      {
        "command": "repoIdentityGuard.fixIdentity",
        "title": "Repo ID: Fix Local Git Identity"
      },
      {
        "command": "repoIdentityGuard.addRuleForCurrentRepo",
        "title": "Repo ID: Add Rule for Current Repo"
      },
      {
        "command": "repoIdentityGuard.copyDiagnosticReport",
        "title": "Repo ID: Copy Diagnostic Report"
      },
      {
        "command": "repoIdentityGuard.openSettings",
        "title": "Repo ID: Open Settings"
      }
    ],
    "configuration": {
      "title": "Repo ID",
      "properties": {
        "repoIdentityGuard.rules": {
          "type": "array",
          "default": [],
          "description": "Git identity rules matched against normalized origin remote URLs. The first matching rule wins.",
          "items": {
            "type": "object",
            "required": [
              "match",
              "label",
              "name",
              "email"
            ],
            "properties": {
              "match": {
                "type": "string",
                "description": "Normalized remote pattern, for example github.com/MyCompany/* or github-work/MyCompany/*."
              },
              "label": {
                "type": "string",
                "description": "Short status bar label for this identity, for example Work or Personal."
              },
              "name": {
                "type": "string",
                "description": "Expected Git commit author name for matching repositories."
              },
              "email": {
                "type": "string",
                "description": "Expected Git commit author email for matching repositories."
              }
            }
          }
        },
        "repoIdentityGuard.requireLocalIdentity": {
          "type": "boolean",
          "default": false,
          "description": "Require matched repositories to set the expected identity in local Git config, even when the effective identity currently matches via global config."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.85.0",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.3"
  }
}
